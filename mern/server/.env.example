PORT=5000
CLIENT_URL=http://localhost:5173
# Optional. Public origin of the deployed SPA (e.g. https://technexa.pk); used by
# the CSRF origin guard in addition to CLIENT_URL.
PUBLIC_ORIGIN=
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=technexa

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=5m

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional. Leave blank to use TechNexa's built-in question generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Monitoring (Prometheus + Grafana)
# Leave METRICS_TOKEN empty for local development. Set a value to require
# "Authorization: Bearer <token>" on GET /metrics.
METRICS_TOKEN=
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
